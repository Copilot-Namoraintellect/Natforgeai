# ═══════════════════════════════════════════════════════════════════
#  Production Environment Configuration for natforgeai.com
#  Fill in ALL values below before deploying
# ═══════════════════════════════════════════════════════════════════

# ── App Secret (generate a strong random string) ─────────────────
# Run this locally to generate:  openssl rand -base64 32
APP_SECRET=GENERATE_A_STRONG_SECRET_HERE

# ── Google Cloud MySQL Database ──────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Get this from your Google Cloud SQL console:
#   - Host = Public IP address of your Cloud SQL instance
#   - Make sure your VPS IP is added to "Authorized networks" in Cloud SQL
DATABASE_URL=mysql://your_db_user:your_db_password@YOUR_CLOUD_SQL_IP:3306/your_database_name

# ── Firebase Admin SDK ───────────────────────────────────────────
# Option A: Path to the service account JSON file on the server
#   Upload your firebase-service-account.json to the VPS and put the path here:
FIREBASE_SERVICE_ACCOUNT=/var/www/natforgeai/firebase-service-account.json
#
# Option B: Paste the entire JSON content as a single-line string
#   (Not recommended for production - use Option A instead)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# ── Firebase Frontend Config (exposed to browser) ────────────────
# Get these from your Firebase project settings → General → Your apps → SDK setup and configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ── Admin Role ───────────────────────────────────────────────────
# Your Firebase UID - you become admin on first login
OWNER_UNION_ID=your_firebase_uid

# ── Node Environment ─────────────────────────────────────────────
NODE_ENV=production
