# ── Backend ─────────────────────────────────────────────────────
APP_SECRET=               # JWT signing secret (generate a strong random string)
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)
PUBLIC_APP_URL=https://natforgeai.com  # Public HTTPS base URL used to resolve relative media paths

# ── Firebase Admin ──────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT= # Path to Firebase service account JSON file, or the JSON content itself

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── OpenAI ──────────────────────────────────────────────────────
OPENAI_API_KEY=           # OpenAI API key for AI agent generation and image generation
OPENAI_IMAGE_MODEL=gpt-image-1      # Image generation model: gpt-image-1 or dall-e-3
OPENAI_IMAGE_OUTPUT_FORMAT=png      # For gpt-image-1: png, jpeg or webp. The API returns b64_json by default.
OPENAI_IMAGE_QUALITY=high           # For gpt-image-1: low, medium, high or auto. For dall-e-3: standard or hd.

# ── Creative Generation Providers ───────────────────────────────
# Creatify (URL-to-Video) marketing video generation
CREATIFY_API_BASE_URL=https://api.creatify.ai
CREATIFY_API_ID=
CREATIFY_API_KEY=
CREATIFY_WEBHOOK_URL=https://natforgeai.com/api/webhooks/creatify

# Future providers (optional placeholders)
HEYGEN_API_KEY=           # Avatar / presenter video generation
RUNWAY_API_KEY=           # Premium motion video generation

# Internal NatForgeAI credit pricing
PREMIUM_IMAGE_CREDITS=10
PREMIUM_IMAGE_INTERNAL_CREDITS=5
PREMIUM_IMAGE_EXTERNAL_CREDITS=10
PREMIUM_VIDEO_CREDITS=100
PREMIUM_HERO_PACK_CREDITS=120

# ── Premium Leaflet Template Provider ───────────────────────────
# Pick ONE provider. Premium leaflet generation is disabled unless
# ENABLE_PREMIUM_TEMPLATE_PROVIDER=true and all template IDs are set.
ENABLE_PREMIUM_TEMPLATE_PROVIDER=false
PREMIUM_TEMPLATE_PROVIDER=bannerbear   # or templatedio

# Bannerbear (optional)
BANNERBEAR_API_KEY=
BANNERBEAR_TEMPLATE_SERVICE_BUSINESS_PROMO=
BANNERBEAR_TEMPLATE_RETAIL_PRODUCT_PROMO=
BANNERBEAR_TEMPLATE_OFFER_DISCOUNT_CAMPAIGN=
BANNERBEAR_TEMPLATE_CORPORATE_PROFESSIONAL=
BANNERBEAR_TEMPLATE_LOCAL_STORE_PROMO=

# Templated.io (optional)
TEMPLATED_IO_API_KEY=
TEMPLATED_IO_TEMPLATE_SERVICE_BUSINESS_PROMO=
TEMPLATED_IO_TEMPLATE_RETAIL_PRODUCT_PROMO=
TEMPLATED_IO_TEMPLATE_OFFER_DISCOUNT_CAMPAIGN=
TEMPLATED_IO_TEMPLATE_CORPORATE_PROFESSIONAL=
TEMPLATED_IO_TEMPLATE_LOCAL_STORE_PROMO=

# System AI usage guardrails (admin/system-level daily/monthly limits)
DAILY_AI_CREDIT_LIMIT=500
MONTHLY_AI_CREDIT_LIMIT=5000

# Provider cost tracking (USD value of one Creatify credit; leave 0 to store raw credits)
CREATIFY_CREDIT_USD=0

# ── Video Rendering ─────────────────────────────────────────────
VIDEO_PROVIDER=local      # Deprecated: local renderer is now "Basic Draft Video" fallback.

# ── SMTP / Transactional Email ──────────────────────────────────
# Used for verification code delivery and password reset links.
# Example values are for SendGrid; set host/port to your provider.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=                  # SMTP/API key
SMTP_FROM=noreply@natforgeai.com

# ── Authentication ──────────────────────────────────────────────
REQUIRE_TWO_FACTOR=true   # When true, all users (including Google/Firebase) must complete OTP/2FA before accessing the app.

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Firebase UID of the app creator; this user gets role "admin" on first login

# ── Social Platform OAuth ───────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://natforgeai.com/api/oauth/callback
# META_OAUTH_SCOPES=public_profile,email,pages_show_list,pages_manage_posts
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://natforgeai.com/api/oauth/linkedin/callback

# ── Video Feature Flags ─────────────────────────────────────────
ENABLE_PREMIUM_VIDEO=false
ENABLE_BASIC_DRAFT_VIDEO=false

# ── Creative Pipeline V2 Rollout Controls ─────────────────────────
# These flags control the V2 creative message-approval authority.
# Production rollout beyond "off" requires explicit operational authorisation.
#
# CREATIVE_PIPELINE_V2_MODE accepts: off | shadow | canary | active.
# "active" is reserved and is treated as "off" by the selector until an
# explicit future rollout decision.
#
# CREATIVE_PIPELINE_V2_CANARY_ENABLED must be "true" for canary mode to
# select traffic; otherwise canary selection is disabled.
#
# Allowlists are comma-separated numeric identifiers (campaign IDs, business
# IDs, user IDs). Leave empty to disable allowlist selection.
#
# CREATIVE_PIPELINE_V2_CANARY_PERCENT is an integer 0-100; 0 disables
# deterministic percent-bucket selection.
#
# CREATIVE_PIPELINE_V2_CANARY_SALT is a non-secret bucketing salt. Leave
# empty in this example and only set via a secure operational process.
#
# CREATIVE_V2_DIAGNOSTIC_HARNESS_ENABLED controls the admin-only,
# fixture-only, in-memory diagnostic authority harness. Keep disabled.
CREATIVE_PIPELINE_V2_MODE=off
CREATIVE_PIPELINE_V2_CANARY_ENABLED=false
CREATIVE_PIPELINE_V2_CANARY_CAMPAIGN_IDS=
CREATIVE_PIPELINE_V2_CANARY_BUSINESS_IDS=
CREATIVE_PIPELINE_V2_CANARY_USER_IDS=
CREATIVE_PIPELINE_V2_CANARY_PERCENT=0
CREATIVE_PIPELINE_V2_CANARY_SALT=
CREATIVE_V2_DIAGNOSTIC_HARNESS_ENABLED=false

# ── Creative Generation Operation Claim Leases ──────────────────
# These values bound how long a creative-generation operation claim
# remains active without a heartbeat. Defaults are provisional and must
# be validated against observed OpenAI generation durations in staging.
#
# CREATIVE_GENERATION_RUNNING_LEASE_SECONDS: active worker/HTTP lease.
# CREATIVE_GENERATION_HEARTBEAT_INTERVAL_SECONDS: how often to renew.
#   Must be strictly less than CREATIVE_GENERATION_RUNNING_LEASE_SECONDS.
# CREATIVE_GENERATION_QUEUED_LEASE_SECONDS: job attached but not yet running.
CREATIVE_GENERATION_RUNNING_LEASE_SECONDS=300
CREATIVE_GENERATION_HEARTBEAT_INTERVAL_SECONDS=60
CREATIVE_GENERATION_QUEUED_LEASE_SECONDS=1800
