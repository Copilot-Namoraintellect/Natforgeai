# NatForgeAI production environment template — WBS-R2.3
# PLACEHOLDERS ONLY. Never commit real values. Copy to .env at deploy time and
# fill every <...> placeholder from the authoritative secret store.
# Classification per docs/recovery/deployment/r2.3-configuration-manifest.md.

# ── Boot-critical (production refuses to start without these) ──────────────
APP_SECRET=<random-hex-or-strong-string>
DATABASE_URL=mysql://<user>:<password>@<host>:3306/<database>
REDIS_URL=redis://:<password>@<host>:6379
FIREBASE_SERVICE_ACCOUNT=<path-to-service-account.json-or-inline-json>

# ── Frontend build-time (Vite bakes these into dist/public) ────────────────
VITE_FIREBASE_API_KEY=<firebase-web-api-key>
VITE_FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<project-id>
VITE_FIREBASE_STORAGE_BUCKET=<project>.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=<sender-id>
VITE_FIREBASE_APP_ID=<app-id>

# ── Core function ──────────────────────────────────────────────────────────
OPENAI_API_KEY=<openai-api-key>
PUBLIC_APP_URL=https://<public-host>
TOKEN_ENCRYPTION_KEY=<64-hex-chars-32-bytes>
META_APP_ID=<meta-app-id>
META_APP_SECRET=<meta-app-secret>
LINKEDIN_CLIENT_ID=<linkedin-client-id>
LINKEDIN_CLIENT_SECRET=<linkedin-client-secret>
STRIPE_SECRET_KEY=<stripe-secret>
STRIPE_WEBHOOK_SECRET=<stripe-webhook-secret>
STRIPE_PUBLISHABLE_KEY=<stripe-publishable>
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>
SMTP_FROM_EMAIL=<from-email>
SMTP_FROM_NAME=<from-name>
# SENDGRID_API_KEY=<alternative-to-smtp>

# ── Platform extras (enable when those platforms go live) ──────────────────
# META_REDIRECT_URI=https://<public-host>/api/oauth/callback
# META_OAUTH_SCOPES=public_profile,email,business_management,pages_show_list,pages_read_engagement,pages_manage_posts,instagram_basic,instagram_content_publishing
# LINKEDIN_REDIRECT_URI=https://<public-host>/api/oauth/linkedin/callback
# FACEBOOK_APP_ID=<>
# FACEBOOK_APP_SECRET=<>
# FACEBOOK_WEBHOOK_VERIFY_TOKEN=<>
# TWITTER_CLIENT_ID=<>
# TWITTER_CLIENT_SECRET=<>
# TIKTOK_CLIENT_KEY=<>
# TIKTOK_CLIENT_SECRET=<>

# ── Owner / admin ──────────────────────────────────────────────────────────
# OWNER_UNION_ID=<firebase-uid-auto-promoted-to-admin>

